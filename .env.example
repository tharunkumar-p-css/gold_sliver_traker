# ── Django Core ──────────────────────────────────────────────────────────────
SECRET_KEY=django-insecure-your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ──────────────────────────────────────────────────────────────────
# Leave empty for SQLite (recommended for dev)
# DATABASE_URL=postgres://user:password@localhost:5432/goldtracker

# ── Email (Gmail SMTP Example) ────────────────────────────────────────────────
# If left empty, emails will be saved to the 'sent_emails/' folder
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=GoldTracker <noreply@goldtracker.com>

# ── Twilio (SMS & WhatsApp) ──────────────────────────────────────────────────
# Get these from your Twilio Console: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ── Telegram Bot ─────────────────────────────────────────────────────────────
# Create a bot via @BotFather and get the token
TELEGRAM_BOT_TOKEN=your_bot_token

# ── Market Data Configuration ────────────────────────────────────────────────
# USD to INR fallback if the live exchange API fails
USD_INR_FALLBACK=83.5
# How often to check for prices (in seconds)
PRICE_CHECK_INTERVAL_SECONDS=60
